{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build app (miniaudio)",          // <-- must match launch.json
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe", // C++ compiler
      "args": [
        "-fdiagnostics-color=always",
        "-g",

        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/miniaudio.c",

        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/include/PDCurses-3.9",
        "-L${workspaceFolder}/include/PDCurses-3.9/wincon",
        "-l:pdcurses.a",

        "-static-libgcc",
        "-static-libstdc++",

        "C:/msys64/ucrt64/lib/libwinpthread.a",

        "-o",
        "${workspaceFolder}/build/app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
